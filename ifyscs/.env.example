# ── Environment ────────────────────────────────────────────────────────────────
# Set to "production" on your server. Never "development" in prod.
FLASK_ENV=production

# ── Security ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# ── Super admin (seed.py creates this account on first run) ────────────────────
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ── Database ───────────────────────────────────────────────────────────────────
# Leave blank to use SQLite (instance/scholaris.db) — fine for small deployments.
# For MySQL / PlanetScale / Railway:
#   DATABASE_URL=mysql+pymysql://user:password@host:3306/scholaris
DATABASE_URL=

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Scholaris <no-reply@scholaris.edu>
# Must be False in production so emails are actually sent.
MAIL_SUPPRESS_SEND=False

# ── Base URL (used in emailed links) ───────────────────────────────────────────
# Set to your public domain, no trailing slash.
# Example: https://scholaris.example.com
BASE_URL=

# ── Deadline reminder scheduler ────────────────────────────────────────────────
DEADLINE_REMINDER_HOUR=8
DEADLINE_REMINDER_MINUTE=0

# ── Rate-limiter storage (optional) ────────────────────────────────────────────
# Use Redis in production to share limits across gunicorn workers.
# Example: redis://localhost:6379/0
# Leave blank to use in-process memory (fine for a single worker).
RATELIMIT_STORAGE_URI=

# ── Google Meet / Calendar API (optional) ──────────────────────────────────────
# Path to a service-account JSON file, OR inline JSON string (one of the two).
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_INFO=
GOOGLE_CALENDAR_ID=primary

# Google OAuth 2.0 (supervisors connect their Google account for Meet links)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback

# ── Zoom Server-to-Server OAuth (optional) ─────────────────────────────────────
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER_EMAIL=me

# Set True to skip real API calls and return placeholder meeting links.
MEETING_DEMO_MODE=false
